# Run `ghostty +show-config --default --docs` to view a list of
# all available config options and their default values.
#
# Additionally, each config option is also explained in detail
# on Ghostty's website, at https://ghostty.org/docs/config.

theme = tokyonight_moon
font-family = JetBrainsMono Nerd Font
font-size = 14
font-thicken = true
font-thicken-strength = 150

custom-shader = shaders/cursor_warp.glsl

# Window Configuration
window-width = 180
window-height = 50
window-padding-x = 6
window-padding-y = 0
window-padding-color = extend

# Cursor Configuration
cursor-style = block
cursor-style-blink = true

# Scrollback
scrollback-limit = 10000

# Terminal features
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = false
selection-invert-fg-bg = true

term = xterm-ghostty
clipboard-write = allow
clipboard-read = allow
clipboard-paste-protection = false

shell-integration-features = no-cursor,ssh-terminfo,ssh-env

macos-option-as-alt = left
macos-titlebar-style = tabs

# https://mwolson.org/blog/2025-11-12-ghostty-tmux-uniform-copy-paste/
copy-on-select = false
keybind = performable:ctrl+shift+c=copy_to_clipboard
# rebind cmd+c to ctrl+shift+c
keybind = super+c=csi:99;6u

# Key bindings for common actions
#keybind = ctrl+c=copy_to_clipboard
#keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+n=new_window
keybind = ctrl+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# Enable Shift+Enter in tmux by remapping as Esc+Enter as tmux
# does not register Shift+Enter. Requires tmux config as well.
keybind = shift+enter=text:\x1b\r

config-file = ?config-linux
